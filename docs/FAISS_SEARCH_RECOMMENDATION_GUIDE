5.3 FAISS Configuration

  // 10M transaction embeddings, 128d, on GPU
  int d = 128;
  int nlist = 4096;        // √(10M) ≈ 3162, round to 4096
  int m = 16;              // 16 sub-quantizers → 16 bytes/vector
  int nbits = 8;
  
  faiss::gpu::StandardGpuResources res;
  faiss::gpu::GpuIndexIVFPQConfig config;
  config.interleavedLayout = true;   // cuVS backend
  
  faiss::gpu::GpuIndexIVFPQ index(&res, d, nlist, m, nbits,
                                   faiss::METRIC_L2, config);
  index.train(n_train, train_data.data());
  index.add(n_db, db_vectors.data());
  
  // At inference time
  index.nprobe = 32;       // search 32 of 4096 clusters
  index.search(1, query.data(), 10, distances.data(), labels.data());
  // Returns top-10 similar historical transactions in ~0.3ms

  Memory budget:
    10M vectors × 16 bytes/vector (PQ) = 160 MB on GPU VRAM
    + centroids + metadata ≈ 200 MB total
    Fits easily in H100 80GB alongside other models

5.4 TigerGraph Fraud Ring Detection

  CREATE QUERY detect_fraud_ring(VERTEX<Card> seed, INT max_hops = 3)
    FOR GRAPH FraudGraph
    RETURNS (MapAccum<STRING, DOUBLE>)
  {
    SetAccum<VERTEX> @@visited;
    MapAccum<STRING, DOUBLE> @@features;
    
    Start = {seed};
    
    // Hop 1: Card → recent transactions → merchants/devices
    Hop1 = SELECT t FROM Start:s -(Transaction:e)- :t
           WHERE e.timestamp > now() - 86400
           ACCUM @@visited += t;
    
    // Hop 2: Shared entities → other cards
    Hop2 = SELECT t FROM Hop1:s -(SharedDevice|SharedIP:e)- :t
           WHERE t NOT IN @@visited
           ACCUM @@visited += t;
    
    // Graph features → feed to ensemble scorer
    @@features += ("ring_size"         -> @@visited.size());
    @@features += ("shared_devices"    -> COUNT(Hop2 WHERE type=="Device"));
    @@features += ("velocity_24h"      -> SUM(Hop1.amount));
    @@features += ("distinct_merchants" -> COUNT(DISTINCT Hop1.merchant_id));
    
    RETURN @@features;
  }

5.5 Zero-Copy Data Flow

  1. ISO 8583 bytes arrive on network buffer (per-core slab)
  2. Rust TxnView<'a> borrows fields as &[u8] from slab — ZERO heap alloc
  3. FeatureBlock constructed in-place in shared memory arena
  4. FAISS: embedding extracted from FeatureBlock, passed to GPU
     → distances written to arena
  5. TigerGraph: graph features written to arena
  6. XGBoost: reads FeatureBlock + FAISS distances + graph features 
     from arena (same memory, no copies)
  7. Ensemble score written to arena
  8. 32-byte descriptor pushed to SPSC ring → event consumer
  9. Arrow RecordBatch wraps arena memory → Tier 2/3 consumers

  Total bytes COPIED per transaction: 47 bytes (descriptor + score)
  Everything else: read by reference from shared memory

