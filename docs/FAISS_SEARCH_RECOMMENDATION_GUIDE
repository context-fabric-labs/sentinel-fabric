3. C++ & RUST API INTEGRATION (ZERO-COPY PATTERNS)

═══════════════════════════════════════════════════════════════════════════

3.1 Why C++/Rust for Search Infrastructure?

  FAISS is natively C++. For low-latency search and fraud detection pipelines
  where we serve ONNX transformer models, XGBoost, and FAISS from the same 
  process — direct C++ integration eliminates:
  • Python GIL overhead
  • HTTP serialization round-trips
  • Cross-process memory copies
  
  Rust provides: memory safety, zero-cost abstractions, excellent FFI to C++,
  and lock-free concurrency primitives.

3.2 C++ API Pattern

  #include <faiss/IndexIVFPQ.h>

  int d = 128, nlist = 4096, m = 16, nbits = 8;
  faiss::IndexFlatL2 quantizer(d);
  faiss::IndexIVFPQ index(&quantizer, d, nlist, m, nbits);

  index.train(n_train, train_data.data());
  index.add(n_db, db_vectors.data());

  int k = 10;
  std::vector<float> distances(nq * k);
  std::vector<faiss::idx_t> labels(nq * k);
  index.nprobe = 32;
  index.search(nq, query.data(), k, distances.data(), labels.data());

3.3 Rust FFI via C API

  FAISS provides c_api/ for FFI integration.
  Build: cmake -B build -DFAISS_ENABLE_C_API=ON
  Produces: libfaiss_c.so
  Functions use faiss_ prefix. Types use Faiss prefix.

  // Rust side (via bindgen)
  extern "C" {
      fn faiss_IndexFlatL2_new(p_index: *mut *mut FaissIndex, d: i64) -> i32;
      fn faiss_Index_add(index: *mut FaissIndex, n: i64, x: *const f32) -> i32;
      fn faiss_Index_search(
          index: *const FaissIndex, n: i64, x: *const f32,
          k: i64, distances: *mut f32, labels: *mut i64
      ) -> i32;
  }

3.4 Zero-Copy Pattern: GPU Embedding → FAISS Search (No D2H Transfer)

  THE CRITICAL OPTIMIZATION: After the NLU/feature model produces an embedding
  on GPU, keep it on GPU and pass the device pointer directly to FAISS GPU.
  This eliminates a ~0.8ms device-to-host + host-to-device round trip.

  // Embedding produced by ONNX/PyTorch on GPU (device memory)
  float* d_query_embedding;  // Already on GPU from NLU forward pass

  // FAISS GPU search — accepts device pointers directly
  faiss::gpu::GpuIndexIVFPQ gpu_index(&res, d, nlist, m, nbits,
                                       faiss::METRIC_L2, config);

  // Search with device pointer — NO cudaMemcpy needed
  float* d_distances;
  faiss::idx_t* d_labels;
  cudaMalloc(&d_distances, nq * k * sizeof(float));
  cudaMalloc(&d_labels, nq * k * sizeof(faiss::idx_t));

  gpu_index.search(nq, d_query_embedding, k, d_distances, d_labels);
  // Results stay on GPU → feed directly to ranking model

3.5 Apache Arrow Zero-Copy Between FAISS and Ranking

  // Wrap FAISS results as Arrow arrays — no copies
  auto distances_buffer = arrow::Buffer::Wrap(distances.data(),
                                               nq * k * sizeof(float));
  auto labels_buffer = arrow::Buffer::Wrap(labels.data(),
                                            nq * k * sizeof(int64_t));

  auto distances_array = std::make_shared<arrow::FloatArray>(
      nq * k, distances_buffer);
  auto labels_array = std::make_shared<arrow::Int64Array>(
      nq * k, labels_buffer);

  // Ranking model reads from same memory — zero copies
  auto record_batch = arrow::RecordBatch::Make(schema,
      nq * k, {distances_array, labels_array});

3.6 Shared Memory Arena + SPSC Ring (Rust)

  /// Hugepage-backed shared memory for inter-component zero-copy
  struct PipelineArena {
      base_ptr: *mut u8,
      write_offset: AtomicU64,
      capacity: usize,
  }

  impl PipelineArena {
      fn allocate(&self, size: usize, align: usize) -> u32 {
          // Atomic bump allocation — returns OFFSET, not pointer
          let aligned = (self.write_offset.load(Relaxed) + align - 1) & !(align - 1);
          self.write_offset.store(aligned + size as u64, Release);
          aligned as u32
      }
  }

  /// SPSC ring carries 32-byte descriptors, not payloads
  #[repr(C, align(64))]
  struct Descriptor {
      arena_offset: u32,
      payload_len: u32,
      stage_mask: u8,       // Which stages have processed
      padding: [u8; 23],
  }

  struct SPSCRing {
      buffer: *mut Descriptor,
      capacity: usize,       // Power of 2
      head: AtomicUsize,     // Consumer (cache-line padded)
      _pad: [u8; 56],
      tail: AtomicUsize,     // Producer (cache-line padded)
  }

