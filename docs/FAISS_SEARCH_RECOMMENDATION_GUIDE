6.3 FAISS Configuration — Dual Mode (Cloud GPU + On-Device CPU)

  // ═══ CLOUD: CAGRA on GPU (10M entities) ═══
  int d = 768;
  
  faiss::gpu::StandardGpuResources res;
  faiss::gpu::GpuIndexCagraConfig cagra_config;
  cagra_config.intermediate_graph_degree = 64;
  cagra_config.graph_degree = 32;
  
  faiss::gpu::GpuIndexCagra cloud_index(
      &res, d, faiss::METRIC_INNER_PRODUCT, cagra_config);
  cloud_index.train(n, data.data());
  cloud_index.add(n, data.data());
  
  // Search: query embedding stays on GPU from NLU forward pass
  cloud_index.search(1, d_query_embedding, 50,
                     d_distances, d_labels);  // ~0.5ms
  
  // ═══ ON-DEVICE: HNSW on CPU (100K contacts per user) ═══
  int M = 32;
  faiss::IndexHNSWFlat device_index(d, M);
  device_index.hnsw.efSearch = 128;
  
  device_index.add(n_contacts, contact_embeddings.data());
  device_index.search(1, query.data(), 10,
                      distances.data(), labels.data());  // ~2ms
  
  // ═══ HYBRID: Build on GPU, serve on CPU ═══
  // Export CAGRA to HNSW format for CPU fallback
  faiss::IndexHNSWFlat cpu_fallback(d, 32);
  cloud_index.copyTo(&cpu_fallback);

  Memory budgets:
    Cloud:    10M × 768d × 4 bytes = 30 GB (GPU VRAM for flat)
              With CAGRA: ~35 GB (graph overhead) → fits H100 80GB
    On-Device: 100K × 768d × 4 bytes = 307 MB (+ HNSW graph ~100 MB)
              Total ~400 MB → fits iPhone 16 Pro (8 GB RAM)

6.4 TigerGraph for Contextual Entity Resolution

  CREATE QUERY resolve_entity(
    VERTEX<User> user,
    STRING entity_name,
    STRING intent,
    UINT context_window     // seconds to look back
  ) FOR GRAPH SiriKnowledgeGraph
    RETURNS (ListAccum<TUPLE<STRING name, STRING phone, DOUBLE score>>)
  {
    ListAccum<TUPLE<STRING name, STRING phone, DOUBLE score>> @@results;
    
    // Hop 1: User's contacts matching entity name
    Contacts = SELECT c FROM user:u -(Knows:e)- Contact:c
               WHERE c.name LIKE entity_name + "%"
               OR levenshtein(c.name, entity_name) < 3;
    
    // Filter by intent context
    IF intent == "MAKE_CALL" THEN
      Contacts = SELECT c FROM Contacts:c WHERE c.phone != "";
    END;
    
    // Hop 2: Context-aware — recent interactions boost score
    FOREACH c IN Contacts DO
      DOUBLE score = 0.0;
      score += 0.4 * log(1 + c.call_frequency);
      score += 0.3 * (1.0 / (1 + hours_since(c.last_interaction)));
      score += 0.2 * c.embedding_similarity;
      score += 0.1 * (1.0 / (1 + c.graph_distance));
      
      @@results += TUPLE(c.name, c.phone, score);
    END;
    
    RETURN @@results ORDER BY score DESC LIMIT 10;
  }

  Multi-Turn Example:
    Turn 1: "What's the weather in Springfield?"
      → FAISS returns: Springfield IL, MO, MA, OR (by embedding similarity)
      → TigerGraph: User lives near Springfield IL (2-hop from home address)
      → Result: Springfield, IL (graph context disambiguates)

    Turn 2: "No, the one in Massachusetts"
      → Context update: user.context_location = "Springfield, MA"
      → No FAISS search needed — context override

6.5 Zero-Copy Pipeline (C++ Shared Memory)

  // Conversational state in hugepage-backed shared memory
  struct ConversationalState {
      // Fixed header (cacheline-aligned)
      uint64_t session_id;
      uint32_t asr_offset;          // ASR hypothesis → arena offset
      uint32_t asr_length;
      uint32_t nlu_embedding_offset; // NLU embedding → arena offset (768 floats)
      uint32_t entity_results_offset; // FAISS + graph results
      uint32_t ranking_offset;
      uint8_t  stage_complete_mask;  // Bitfield: ASR|NLU|Search|Rank|TTS
      uint32_t arena_offset;         // Bump allocator position
  };

  // Stage C accessor — zero-copy reads from previous stages
  class SearchStageAccessor {
      ConversationalState* state;
      
  public:
      // Read ASR text without copy
      std::string_view get_asr_text() {
          return {(char*)state + state->asr_offset, state->asr_length};
      }
      
      // Get embedding pointer (already on GPU if GPU path)
      float* get_query_embedding() {
          return (float*)((char*)state + state->nlu_embedding_offset);
      }
      
      // Write search results to arena
      void write_results(const SearchResult* results, size_t n) {
          uint32_t offset = state->arena_offset;
          memcpy((char*)state + offset, results, n * sizeof(SearchResult));
          state->entity_results_offset = offset;
          state->arena_offset = offset + n * sizeof(SearchResult);
          state->stage_complete_mask |= SEARCH_COMPLETE;
      }
  };

