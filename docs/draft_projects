																				Why memmap2 specifically
																				The Rust memmap2 crate is the maintained successor to memmap and provides:
																					w Safe abstractions over mmap / munmap
																					w MmapMut for read-write mappings
																					w Automatic munmap on drop
																					w Cross-platform support (though we only need Linux)
																					w No unsafe in user code (the crate handles it internally)
																					It's used here instead of raw libc::mmap because:
																						w The audit consumer is a pure Rust service (no C++ dependency)
																						w memmap2 handles edge cases (partial maps, alignment, drop semantics)
																						w Code is more maintainable
																						
																						③ Model weight loading via mmap (memory-mapped files)
																						The problem
																						XGBoost model files (~200 MB) and ONNX models (~500 MB) were loaded into memory using standard file I/O:
																						
																						
																						
																						C++
																						// Naive: read entire file into heap
																						std::vector<char> model_data(file_size);
																						file.read(model_data.data(), file_size); // copies entire file into RAM
																						Show more lines
																						This is wasteful because:
																							w The entire model is copied from page cache into heap memory
																							w Two copies exist in RAM (page cache + heap)
																							w Loading takes seconds for large models
																							w Memory usage doubles
																							The fix: mmap the model file directly from NVMe
																							
																							
																							
																							C++
																							#include <sys/mman.h>
																							#include <fcntl.h>
																							
																							class MmapModelLoader {
																							public:
																							 // Memory-map a model file from NVMe
																							 // The kernel maps NVMe pages directly into our address space
																							 // NO COPY into heap — we read directly from page cache
																							 static MmapModelLoader load(const char* path, int numa_node) {
																							 int fd = open(path, O_RDONLY);
																							 if (fd < 0) throw std::runtime_error("open failed");
																							
																							 struct stat st;
																							 fstat(fd, &st);
																							 size_t size = st.st_size;
																							
																							 void* ptr = mmap(
																							 nullptr,
																							 size,
																							 PROT_READ, // read-only (model weights don't change)
																							 MAP_PRIVATE | MAP_POPULATE, // MAP_POPULATE: pre-fault all pages
																							 fd,
																							 0
																							 );
																							
																							 if (ptr == MAP_FAILED) {
																							 close(fd);
																							 throw std::runtime_error("mmap failed");
																							 }
																							
																							 // Advise kernel about access pattern
																							 madvise(ptr, size, MADV_SEQUENTIAL); // we'll read linearly
																							 madvise(ptr, size, MADV_HUGEPAGE); // use hugepages if possible
																							
																							 // NUMA-pin the model pages to the correct node
																							 unsigned long nodemask = 1UL << numa_node;
																							 mbind(ptr, size, MPOL_BIND, &nodemask,
																							 sizeof(nodemask) * 8, MPOL_MF_MOVE);
																							
																							 close(fd); // fd can be closed after mmap — mapping persists
																							
																							 return MmapModelLoader{
																							 static_cast<const uint8_t*>(ptr), size
																							 };
																							 }
																							
																							 const uint8_t* data() const { return data_; }
																							 size_t size() const { return size_; }
																							
																							 ~MmapModelLoader() {
																							 if (data_) munmap(const_cast<uint8_t*>(data_), size_);
																							 }
																							
																							private:
																							 MmapModelLoader(const uint8_t* data, size_t size)
																							 : data_(data), size_(size) {}
																							
																							 const uint8_t* data_;
																							 size_t size_;
																							};
