																				 /// ZERO COPY: Arrow reads directly from the mmap'd pages
																				 /// No deserialization — Arrow IPC format IS the in-memory format
																				 pub fn read_batch(&self)
																				 -> Result<arrow::record_batch::RecordBatch, Box<dyn std::error::Error>>
																				 {
																				 // Read control header (last cache line = bytes written)
																				 let control_offset = self.buffer_size - 64;
																				 let bytes_written = u64::from_ne_bytes(
																				 self.mmap[control_offset..control_offset + 8]
																				 .try_into()?
																				 ) as usize;
																				
																				 if bytes_written == 0 {
																				 return Err("No data available".into());
																				 }
																				
																				 // Memory fence: ensure we see all data from producer
																				 std::sync::atomic::fence(std::sync::atomic::Ordering::Acquire);
																				
																				 // Read Arrow IPC from the mmap'd buffer
																				 // Arrow's StreamReader can read directly from a byte slice
																				 // — it does NOT copy the data, it creates zero-copy ArrayRef
																				 // views into the underlying buffer
																				 let cursor = Cursor::new(&self.mmap[..bytes_written]);
																				 let mut reader = StreamReader::try_new(cursor, None)?;
																				
																				 let batch = reader.next()
																				 .ok_or("No batches in stream")??;
																				
																				 Ok(batch)
																				 }
																				}
