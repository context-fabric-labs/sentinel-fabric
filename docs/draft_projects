																				class ArrowShmPublisher {
																				public:
																				 ArrowShmPublisher(const char* shm_name,
																				 size_t buffer_size,
																				 int numa_node)
																				 : buffer_size_(buffer_size)
																				 {
																				 // Create shared memory for Arrow IPC
																				 fd_ = shm_open(shm_name, O_CREAT | O_RDWR, 0600);
																				 ftruncate(fd_, buffer_size_);
																				
																				 base_ = static_cast<uint8_t*>(mmap(
																				 nullptr, buffer_size_,
																				 PROT_READ | PROT_WRITE,
																				 MAP_SHARED, fd_, 0
																				 ));
																				
																				 madvise(base_, buffer_size_, MADV_HUGEPAGE);
																				
																				 // NUMA-pin the shared memory pages
																				 unsigned long nodemask = 1UL << numa_node;
																				 mbind(base_, buffer_size_, MPOL_BIND, &nodemask,
																				 sizeof(nodemask) * 8, MPOL_MF_MOVE);
																				
																				 // Pre-fault
																				 memset(base_, 0, buffer_size_);
																				 }
																				
																				 // Write an Arrow RecordBatch directly into shared memory
																				 // The downstream consumer (audit service) reads from
																				 // the same shm region — zero copy, zero serialization
																				 void publish(const std::shared_ptr<arrow::RecordBatch>& batch) {
																				 // Wrap the mmap'd region as an Arrow OutputStream
																				 auto buffer = std::make_shared<arrow::MutableBuffer>(
																				 base_, buffer_size_
																				 );
																				 auto sink = arrow::io::FixedSizeBufferWriter(buffer);
																				
																				 // Write Arrow IPC format directly into shared memory
																				 auto writer = arrow::ipc::MakeStreamWriter(
																				 &sink, batch->schema()
																				 ).ValueOrDie();
																				
																				 writer->WriteRecordBatch(*batch);
																				 writer->Close();
																				
																				 // Signal consumer (write the actual bytes written)
																				 auto* header = reinterpret_cast<volatile uint64_t*>(
																				 base_ + buffer_size_ - 64 // last cache line = control
																				 );
																				 *header = sink.bytes_written();
																				
																				 // Fence to ensure consumer sees all data
																				 __atomic_thread_fence(__ATOMIC_RELEASE);
																				 }
																				
																				 ~ArrowShmPublisher() {
																				 munmap(base_, buffer_size_);
																				 close(fd_);
																				 }
																				
																				private:
																				 int fd_;
																				 uint8_t* base_;
																				 size_t buffer_size_;
