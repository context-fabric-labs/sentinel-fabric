														What I built: Token-budget admission controller with GPU headroom policy
														
														
														
														Rust
														use std::sync::atomic::{AtomicI64, Ordering};
														
														/// Per-model admission controller
														/// Tracks estimated token budget vs capacity
														pub struct AdmissionController {
														 // Current estimated tokens in flight
														 tokens_in_flight: AtomicI64,
														
														 // Maximum tokens allowed (based on GPU memory / KV cache capacity)
														 max_tokens: i64,
														
														 // Per-tenant tracking
														 tenant_tokens: DashMap<String, AtomicI64>,
														
														 // GPU health integration
														 gpu_monitor: Arc<GpuMonitor>,
														
														 // Configuration
														 config: AdmissionConfig,
														}
														
														#[derive(Clone)]
														pub struct AdmissionConfig {
														 pub max_tokens_per_model: i64,
														 pub max_tokens_per_tenant: i64,
														 pub gpu_memory_headroom_mb: u64, // deny if GPU free < this
														 pub gpu_utilization_cap: f32, // throttle if GPU util > this
														 pub kv_cache_pressure_threshold: f32, // deny if KV usage > this
														}
														
														/// GPU health monitor (reads NVML/DCGM via FFI to C library)
														pub struct GpuMonitor {
														 gpu_memory_free_mb: AtomicU64,
														 gpu_utilization_pct: AtomicU32,
														 kv_cache_usage_pct: AtomicU32, // from vLLM metrics endpoint
														}
														
														impl AdmissionController {
														 /// Evaluate whether to admit a request
														 pub async fn admit(
														 &self,
														 tenant_id: &str,
														 model: &str,
														 estimated_prompt_tokens: i64,
														 estimated_max_output_tokens: i64,
														 priority: Priority,
														 ) -> AdmissionDecision {
														 let total_tokens = estimated_prompt_tokens
														 + estimated_max_output_tokens;
														
														 // Check 1: GPU memory headroom
														 let gpu_free = self.gpu_monitor.gpu_memory_free_mb
														 .load(Ordering::Relaxed);
														 if gpu_free < self.config.gpu_memory_headroom_mb {
														 return AdmissionDecision::Reject {
														 reason: "GPU memory below headroom threshold",
														 retry_after_ms: 500,
														 };
														 }
														
														 // Check 2: KV cache pressure
														 let kv_pct = self.gpu_monitor.kv_cache_usage_pct
														 .load(Ordering::Relaxed);
														 if kv_pct > (self.config.kv_cache_pressure_threshold * 100.0)
														 as u32 {
														 // Under KV pressure: only admit high-priority
														 if priority < Priority::Checkout {
														 return AdmissionDecision::Degrade {
														 action: DegradeAction::ClampMaxTokens(256),
														 reason: "KV cache pressure — clamping output",
														 };
														 }
														 }
														
														 // Check 3: Global token budget
														 let current = self.tokens_in_flight
														 .load(Ordering::Relaxed);
														 if current + total_tokens > self.max_tokens {
														 // Over budget: shed low-priority traffic
														 if priority <= Priority::Analytics {
														 return AdmissionDecision::Reject {
														 reason: "Token budget exceeded",
														 retry_after_ms: 1000,
														 };
														 }
														 // High-priority: degrade instead of reject
														 return AdmissionDecision::Degrade {
														 action: DegradeAction::FallbackToSmallerModel,
														 reason: "Token budget tight — falling back",
														 };
														 }
														
														 // Check 4: Per-tenant budget
														 let tenant_current = self.tenant_tokens
														 .entry(tenant_id.to_string())
														 .or_insert_with(|| AtomicI64::new(0))
														 .load(Ordering::Relaxed);
														 if tenant_current + total_tokens
														 > self.config.max_tokens_per_tenant {
														 return AdmissionDecision::Reject {
														 reason: "Tenant token quota exceeded",
														 retry_after_ms: 200,
														 };
														 }
														
														 // Admit: reserve tokens
														 self.tokens_in_flight
														 .fetch_add(total_tokens, Ordering::Relaxed);
														 self.tenant_tokens
														 .get(tenant_id)
														 .unwrap()
														 .fetch_add(total_tokens, Ordering::Relaxed);
														
														 AdmissionDecision::Admit {
														 reserved_tokens: total_tokens,
														 tenant_id: tenant_id.to_string(),
														 }
														 }
														
														 /// Called when request completes: release token budget
														 pub fn release(&self, tenant_id: &str, tokens: i64) {
														 self.tokens_in_flight
														 .fetch_sub(tokens, Ordering::Relaxed);
														 if let Some(t) = self.tenant_tokens.get(tenant_id) {
														 t.fetch_sub(tokens, Ordering::Relaxed);
														 }
														 }
														}
														
