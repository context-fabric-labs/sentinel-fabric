																							 /// Zero-copy: kernel maps file pages directly into our address space
																							 pub fn load(path: &str) -> Result<Self, Box<dyn std::error::Error>> {
																							 let file = File::open(path)?;
																							
																							 // Safety: file must not be modified while mapped
																							 // (model files are read-only, so this is safe)
																							 let mmap = unsafe { Mmap::map(&file)? };
																							
																							 // Advise kernel: we'll read sequentially, use hugepages
																							 mmap.advise(memmap2::Advice::Sequential)?;
																							 mmap.advise(memmap2::Advice::HugePage)?;
																							
																							 Ok(Self { mmap })
																							 }
																							
																							 /// Get a byte slice view of the model weights
																							 /// ZERO COPY: this IS the page cache, not a copy
																							 pub fn as_bytes(&self) -> &[u8] {
																							 &self.mmap[..]
																							 }
																							}
