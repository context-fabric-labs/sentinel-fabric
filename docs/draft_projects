																				// Layout of the shared memory region between Rust gateway and C++ engine
																				// Both sides agree on this layout at compile time
																				struct HotPathSharedRegion {
																				 // ─── Input area (Rust writes, C++ reads) ───
																				 alignas(64) uint8_t input_buffer[4 * 1024 * 1024]; // 4 MB for raw transactions
																				 alignas(64) uint64_t input_len; // actual bytes written
																				 alignas(64) uint64_t request_count; // number of transactions
																				
																				 // ─── Output area (C++ writes, Rust reads) ───
																				 alignas(64) int8_t decisions[8192]; // decision per transaction
																				 alignas(64) float scores[8192]; // risk score per transaction
																				 alignas(64) uint64_t output_count; // actual results written
																				
																				 // ─── Control flags (atomic, cache-line aligned) ───
																				 alignas(64) volatile uint64_t request_ready; // Rust sets to 1 when input is ready
																				 alignas(64) volatile uint64_t response_ready; // C++ sets to 1 when output is ready
																				};
																				
																				class SharedMemoryManager {
																				public:
																				 // Create a POSIX shared memory region on a specific NUMA node
																				 SharedMemoryManager(const char* shm_name, int numa_node)
																				 : shm_name_(shm_name)
																				 , numa_node_(numa_node)
																				 , region_(nullptr)
																				 {
																				 // Step 1: Create shared memory object
																				 fd_ = shm_open(shm_name, O_CREAT | O_RDWR, 0600);
																				 if (fd_ < 0) {
																				 throw std::runtime_error("shm_open failed");
																				 }
																				
																				 // Step 2: Set size
																				 size_ = sizeof(HotPathSharedRegion);
																				 if (ftruncate(fd_, size_) != 0) {
																				 throw std::runtime_error("ftruncate failed");
																				 }
																				
																				 // Step 3: mmap the region
																				 void* ptr = mmap(
																				 nullptr,
																				 size_,
																				 PROT_READ | PROT_WRITE,
																				 MAP_SHARED, // visible to other processes
																				 fd_,
																				 0
																				 );
																				 if (ptr == MAP_FAILED) {
																				 throw std::runtime_error("mmap failed");
																				 }
																				
																				 // Step 4: Advise kernel to use hugepages for TLB efficiency
																				 madvise(ptr, size_, MADV_HUGEPAGE);
																				
																				 // Step 5: Pin the pages to the correct NUMA node
																				 // This is critical: without this, the kernel may place pages
																				 // on the wrong NUMA node based on first-touch policy
																				 unsigned long nodemask = 1UL << numa_node;
																				 if (mbind(ptr, size_, MPOL_BIND, &nodemask,
																				 sizeof(nodemask) * 8, MPOL_MF_MOVE) != 0) {
																				 // mbind failed — pages may not be on correct NUMA node
																				 // Log warning but don't fail (will still work, just slower)
																				 fprintf(stderr, "WARNING: mbind failed for shm region\n");
																				 }
																				
																				 // Step 6: Pre-fault all pages (avoid page faults on hot path)
																				 memset(ptr, 0, size_);
																				
																				 region_ = static_cast<HotPathSharedRegion*>(ptr);
																				 }
																				
																				 ~SharedMemoryManager() {
																				 if (region_) {
																				 munmap(region_, size_);
																				 }
																				 if (fd_ >= 0) {
																				 close(fd_);
																				 shm_unlink(shm_name_.c_str());
																				 }
																				 }
																				
																				 HotPathSharedRegion* region() { return region_; }
																				
																				private:
																				 std::string shm_name_;
																				 int numa_node_;
																				 int fd_;
																				 size_t size_;
																				 HotPathSharedRegion* region_;
																				};
